{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Andean Crops Nutritional Database",
  "type": "object",
  "required": ["version", "lastUpdated", "unit", "cultivars"],
  "properties": {
    "version": { "type": "string" },
    "lastUpdated": { "type": "string", "format": "date" },
    "unit": { "type": "string" },
    "cultivars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "commonName", "localNames", "scientificName", "family",
          "classification", "badgeClass", "originRegion", "altitudeRangeMasl",
          "basis", "basisLabel", "moisturePct", "calories", "protein",
          "carbs", "fiber", "lipids", "iron", "calcium", "zinc", "vitaminC",
          "bioactives", "antinutrientsAndProcessing", "sources"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "commonName": { "type": "string", "minLength": 2 },
          "localNames": { "type": "array", "items": { "type": "string" } },
          "scientificName": { "type": "string", "minLength": 3 },
          "family": { "type": "string", "minLength": 3 },
          "classification": {
            "type": "string",
            "enum": ["Pseudocereal", "Tuber/Root", "Legume", "Grain", "Fruit", "Seed/Alga"]
          },
          "badgeClass": { "type": "string" },
          "originRegion": { "type": "string" },
          "altitudeRangeMasl": { "type": "string" },
          "basis": { "type": "string", "enum": ["dry", "fresh_raw", "dried_processed"] },
          "basisLabel": { "type": "string" },
          "moisturePct": { "type": "number", "minimum": 0, "maximum": 99 },
          "calories": { "type": "number", "minimum": 0 },
          "protein": { "type": "number", "minimum": 0 },
          "carbs": { "type": "number", "minimum": 0 },
          "fiber": { "type": "number", "minimum": 0 },
          "lipids": { "type": "number", "minimum": 0 },
          "iron": { "type": "number", "minimum": 0 },
          "calcium": { "type": "number", "minimum": 0 },
          "zinc": { "type": "number", "minimum": 0 },
          "vitaminC": { "type": "number", "minimum": 0 },
          "bioactives": { "type": "string", "minLength": 10 },
          "antinutrientsAndProcessing": { "type": "string", "minLength": 10 },
          "sources": {
            "type": "object",
            "required": ["composition", "bioactives"],
            "properties": {
              "composition": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "bioactives": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
