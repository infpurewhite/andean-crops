{
  "name": "andean-crops",
  "version": "0.3.0",
  "description": "Nutrient composition explorer and curated dataset for eight Andean crops, with per-value provenance and data-quality checks.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "eslint .",
    "validate": "node scripts/validate-dataset.mjs",
    "export": "node scripts/export-csv.mjs",
    "check": "npm run lint && npm run validate && npm test",
    "check:references": "node scripts/check-references.mjs",
    "site:copy": "node scripts/copy-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
